{
  "name": "@sgftech/payment-razorpay",
  "version": "2.1.10",
  "description": "razorpay payment provider for Medusa v2",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgftech/payment-razorpay",
    "directory": "."
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": "22.14.0"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "test": "jest --passWithNoTests src",
    "clean": "rimraf *.tgz dist",
    "build": "yarn run clean && tsc --build ./tsconfig.json",
    "watch": "tsc --watch",
    "lint": "eslint ./ --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "prepack": "yarn run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "yarn test"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "src/**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write --ignore-unknown"
  },
  "pre-commit": "lint-staged",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "@jest/globals": "^29.2.6",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.1",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.4",
    "jest": "^29.2.6",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.6.0",
    "@medusajs/cli": "^2.6.0",
    "@medusajs/framework": "^2.6.0",
    "@medusajs/medusa": "^2.6.0",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/knex": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/postgresql": "6.4.3",
    "awilix": "^8.0.1",
    "pg": "^8.13.0",
    "razorpay": "^2.9.5",
    "react-dom": "^18.0.0"
  },
  "gitHead": "81a7ff73d012fda722f6e9ef0bd9ba0232d37808",
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-payment"
  ]
}
