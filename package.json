{
  "name": "@sgftech/payment-razorpay",
  "version": "2.1.10",
  "description": "razorpay payment provider for Medusa v2",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgftech/payment-razorpay",
    "directory": "."
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.5.2"
  },
  "author": "Medusa",
  "license": "MIT",
  "scripts": {
    "test": "jest --passWithNoTests src",
    "clean": "rimraf *.tgz dist",
    "build": "pnpm run clean &&tsc --build ./tsconfig.json",
    "watch": "tsc --watch",
    "lint": "eslint ./ --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "prepack": "pnpm run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "src/**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write --ignore-unknown"
  },
  "pre-commit": "lint-staged",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^29.2.6",
    "@medusajs/admin-sdk": "latest",
    "@medusajs/cli": "latest",
    "@medusajs/framework": "^2.5.1",
    "@medusajs/medusa": "latest",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.3.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-typescript": "^3.0.0",
    "eslint-plugin-file-progress": "^1.3.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.4",
    "jest": "^29.2.6",
    "prettier": "^2.7.1",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.4.0",
    "@medusajs/cli": "^2.4.0",
    "@medusajs/framework": "^2.4.0",
    "@medusajs/medusa": "^2.4.0",
    "awilix": "^8.0.1"
  },
  "dependencies": {
    "@medusajs/utils": "^2.5.1",
    "razorpay": "^2.9.5"
  },
  "gitHead": "81a7ff73d012fda722f6e9ef0bd9ba0232d37808",
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-payment"
  ]
}
